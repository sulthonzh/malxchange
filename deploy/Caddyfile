# malxchange edge (ADR-0007): Caddy terminates TLS for both apps and the
# member WebSocket path. Values come from the .env via Caddy's {$ENV}
# placeholders; the Redpanda Console is deliberately NOT proxied here —
# it stays bound to the host loopback only (docker compose ps shows the
# published port; tunnel in with SSH when you need it).

https://{$MAL_DOMAIN} {
	tls internal
	encode zstd gzip

	# member REST API (issue #24 defines the public paths)
	handle /api/* {
		reverse_proxy api:8080
	}

	# single member WebSocket endpoint (ADR-0011)
	handle /ws {
		reverse_proxy api:8080
	}

	# member web app, SSR (container lands with issue #24)
	reverse_proxy web:3000
}

https://{$MAL_ADMIN_DOMAIN} {
	tls internal
	encode zstd gzip

	# admin REST (spec #25): the admin-api backend, same-origin with
	# the app so the httpOnly session cookie rides browser requests —
	# REST-only, no WebSocket on this vhost.
	handle /api/* {
		reverse_proxy admin-api:8080
	}

	# the admin app, SSR (spec #25, issue #56)
	reverse_proxy admin:3000
}
