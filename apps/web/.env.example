# Runtime host configuration for the web app (spec #24, story 33).
# Copy this file to .env for local development. The same variables feed
# the Nuxt server process in every other environment; changing them
# changes the hosts with no code change. The api base includes the /api
# prefix (the member REST lives under it — Caddy proxies /api/* to the
# api service unstripped), for example https://exchange.example.com/api
# or http://127.0.0.1:8080/api when running the api binary directly.
NUXT_PUBLIC_API_BASE_URL=
NUXT_PUBLIC_WS_URL=
