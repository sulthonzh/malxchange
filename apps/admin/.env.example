# Runtime host configuration for the admin app (spec #25, issue #56).
# Copy this file to .env for local development. The same variables feed
# the Nuxt server process in every other environment; changing them
# changes the hosts with no code change. The bases are ORIGINS — the
# admin-api serves its whole surface under /api/* itself (Caddy proxies
# /api/* to the admin-api service on the admin domain).
NUXT_PUBLIC_ADMIN_API_BASE_URL=
# Server-side (SSR) admin-api origin, for example http://admin-api:8080
# inside the compose network. SSR runs server-to-server, where the
# browser's published host is not reachable; unset falls back to
# NUXT_PUBLIC_ADMIN_API_BASE_URL.
NUXT_ADMIN_API_BASE_URL=
