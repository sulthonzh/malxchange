# Runtime host configuration for the web app (spec #24, story 33).
# Copy this file to .env for local development. The same variables feed
# the Nuxt server process in every other environment; changing them
# changes the hosts with no code change. Values are full origins, for
# example http://127.0.0.1:8080 — no host ships inside the source tree.
NUXT_PUBLIC_API_BASE_URL=
NUXT_PUBLIC_WS_URL=
