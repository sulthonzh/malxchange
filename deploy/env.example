# Reference of every variable deploy/docker-compose.yaml consumes.
# install/install.sh generates deploy/.env with real secrets (never commit
# it). For local dev, `make dev-up` seeds a throwaway .env from this shape.

# Edge
MAL_DOMAIN=exchange.example.com
MAL_ADMIN_DOMAIN=admin.exchange.example.com

# Postgres (one superuser for init/backups; one login role per service)
MAL_PG_SUPERUSER=malxchange
MAL_PG_SUPERUSER_PASSWORD=replace-me
MAL_PG_DATABASE=malxchange
MAL_PG_PASSWORD_API=replace-me
MAL_PG_PASSWORD_EXCHANGE=replace-me
MAL_PG_PASSWORD_MARKET=replace-me
MAL_PG_PASSWORD_WALLET=replace-me
MAL_PG_PASSWORD_ADMIN=replace-me

# Redpanda SASL (one app principal; SCRAM-SHA-256)
MAL_KAFKA_USER=malxchange
MAL_KAFKA_PASSWORD=replace-me

# Chain node RPC (btcd/ltcd, chains profile)
MAL_BTCD_RPCUSER=malxchange
MAL_BTCD_RPCPASSWORD=replace-me
MAL_LTCD_RPCUSER=malxchange
MAL_LTCD_RPCPASSWORD=replace-me

# Service-side secrets (consumed from issue #22 wallet onward)
MAL_PEPPER=replace-me
MAL_HOT_KEYSTORE_PASSPHRASE=replace-me

# Backups
MAL_BACKUP_DIR=./backups
MAL_BACKUP_KEEP=14
