# ltcd from source (pinned; ltcsuite is a Beta fork per the wallet-stack
# research — the pin is the containment). secp256k1 needs cgo here, hence
# gcc/musl-dev. The node's JSON-RPC is the interface; no ltcctl needed.
FROM golang:1.26-alpine AS build
RUN apk add --no-cache gcc musl-dev
RUN go install github.com/ltcsuite/ltcd@v0.23.6

FROM alpine:3.21
COPY --from=build /go/bin /bin
EXPOSE 9333 9334
ENTRYPOINT ["ltcd"]
