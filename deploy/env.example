# Reference of every variable deploy/docker-compose.yaml consumes.
# install/install.sh generates deploy/.env with real secrets (never commit
# it). For local dev, `make dev-up` seeds a throwaway .env from this shape.

# Edge
MAL_DOMAIN=exchange.example.com
MAL_ADMIN_DOMAIN=admin.exchange.example.com

# Postgres (one superuser for init/backups; one login role per service)
MAL_PG_SUPERUSER=malxchange
MAL_PG_SUPERUSER_PASSWORD=replace-me
MAL_PG_DATABASE=malxchange
MAL_PG_PASSWORD_API=replace-me
MAL_PG_PASSWORD_EXCHANGE=replace-me
MAL_PG_PASSWORD_MARKET=replace-me
MAL_PG_PASSWORD_WALLET=replace-me
MAL_PG_PASSWORD_ADMIN=replace-me

# Redpanda SASL (one app principal; SCRAM-SHA-256)
MAL_KAFKA_USER=malxchange
MAL_KAFKA_PASSWORD=replace-me

# Chain node RPC (btcd/ltcd, chains profile)
MAL_BTCD_RPCUSER=malxchange
MAL_BTCD_RPCPASSWORD=replace-me
MAL_LTCD_RPCUSER=malxchange
MAL_LTCD_RPCPASSWORD=replace-me
# EVM / TRON RPC (operator-supplied; unset = watch-only for the family)
MAL_EVM_RPC_URL=
MAL_EVM_RPC_FALLBACK_URL=
MAL_TRON_ENDPOINT=
MAL_TRON_API_KEY=
# BTC/LTC node RPC URLs (the chains profile sets these to the in-compose
# nodes; override for an external node). Unset = watch-only for the family.
MAL_BTCD_URL=
MAL_LTCD_URL=
# Wallet watcher: network (mainnet|simnet — must match the node), poll
# cadence, and whether to skip TLS verification on the nodes' self-signed
# certs (true inside compose, false for a node with a real cert).
MAL_WALLET_NET=
MAL_WALLET_POLL=
MAL_CHAIN_TLS_SKIP_VERIFY=
# Hot keystore file on the wallet host (created by cmd/walletctl during
# the key ceremony — see install/key-ceremony.md); unset = watch-only.
MAL_WALLET_KEYSTORE=

# Service-side secrets (consumed from issue #22 wallet onward)
MAL_PEPPER=replace-me
MAL_HOT_KEYSTORE_PASSPHRASE=replace-me

# Backups
MAL_BACKUP_DIR=./backups
MAL_BACKUP_KEEP=14

# Member auth (issue #24, ADR-0006). SMTP empty = no outbound mail (the
# compose test profile points it at the mail sink); code TTL/cooldown and
# the failed-login lockout window are durations; the session TTL is the
# sliding expiry of a signed-in device.
MAL_API_SMTP_HOST=
MAL_API_SMTP_PORT=25
MAL_API_SMTP_USER=
MAL_API_SMTP_PASS=
MAL_API_SMTP_FROM=malxchange@localhost
MAL_API_CODE_TTL=5m
MAL_API_CODE_COOLDOWN=30s
MAL_API_LOCKOUT_WINDOW=15m
MAL_API_SESSION_TTL=168h
